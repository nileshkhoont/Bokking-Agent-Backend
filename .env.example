PORT=5000
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:5000
# CORS_ORIGINS=["http://localhost:3000"]

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ai_calling_agent

# Admin JWT auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Shared secret required in the X-Tool-Secret header on every agent_tools call — must match the
# header value configured on each Edesy Function (scripts/bootstrap_edesy_agent.py sets this)
AGENT_TOOL_SECRET=change-me-to-a-long-random-string

# Edesy AI Voice Agent (voice-agent.edesy.in) — calling is fully delegated to this hosted service
EDESY_BASE_URL=https://voice-agent.edesy.in
EDESY_API_KEY=
EDESY_WEBHOOK_SECRET=
EDESY_AGENT_ID=

# Redis / Celery — drives the call_schedules outbound queue worker
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# call_schedules queue tuning
OUTBOUND_CALL_POLL_INTERVAL_SECONDS=30
MISSED_CALL_RETRY_DELAY_MINUTES=60
DEFAULT_MAX_CALL_ATTEMPTS=3
ARCHIVE_AFTER_DAYS=545
